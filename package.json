{
  "name": "jobsafe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "JobSafe Tracker - a private job tracker for Philippine job seekers with scam warning checks.",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p packages/shared && pnpm --filter @jobsafe/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "pnpm --filter @jobsafe/web dev",
    "build:web": "pnpm --filter @jobsafe/web build",
    "test:groq": "node tools/groq-model-test.mjs",
    "eval": "node eval/run-eval.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "globals": "^16.5.0"
  }
}
