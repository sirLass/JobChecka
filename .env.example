# Copy to .env (never commit .env) and fill in real values.
# Keys marked "-- server only" must never appear in client bundles or the extension.

# ---- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # -- server only: bypasses RLS; handle with care

# ---- AI -------------------------------------------------------------------
GROQ_API_KEY=                     # -- server only
GROQ_MODEL=                       # chosen in Phase 0 model test; keep configurable
AI_DAILY_LIMIT_PER_USER=20        # per-user daily AI check cap

# ---- Safe browsing lookup -------------------------------------------------
SAFE_BROWSING_API_KEY=            # -- server only (Google Safe Browsing or alternative)
